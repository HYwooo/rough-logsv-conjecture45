                #box(fill: rgb(255, 255, 255, 220), inset: (x: 4pt, y: 2pt))[
                  #align(right)[
                    #text(size: 7.6pt, fill: luma(55))[
                      #if is-zh [实线低于同色虚线即得 $epsilon.alt_0 > 0$] else [Margin $> 0$ below dashed $upright("LHS")_H$]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      )
    ]
  ]
}
